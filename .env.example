# Copy to .env (gitignored) or let scripts/provision.sh fill it in.
# SUPABASE_URL, SUPABASE_ANON_KEY and GOOGLE_MAPS_API_KEY are also set as Netlify
# environment variables; scripts/build.mjs bakes them into the generated config.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Restricted (HTTP referrer) to the Netlify domain, with the Places API and Maps
# JavaScript API enabled. There is no in-app UI for pasting a personal key.
GOOGLE_MAPS_API_KEY=

# Local tooling and tests only — never a Netlify variable, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The single provisioned account, used by the integration tests.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

NETLIFY_SITE_URL=
